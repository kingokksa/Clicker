# Flutter
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Build outputs (ephemeral only, not generated CMake files)
windows/flutter/ephemeral/
linux/flutter/ephemeral/
android/.gradle/
android/app/build/
android/local.properties

# User data
profiles/config.json
macros/*.json

# Dev tool config
.omo/

# Misc
*.pyc
__pycache__/
.ruff_cache/
*.pdb

# Driver build caches (recoverable via packages.config / VS)
driver/clicker_filter/.vs/
driver/clicker_filter/packages/
driver/clicker_filter/build/
driver/clicker_filter/x64/
driver/**/*.vcxproj.user

# Allow driver binaries in driver/ directory
!driver/**/*.sys
!driver/**/*.cat
!driver/**/*.inf

# Test coverage output (CI artifact, not committed)
coverage/

# --- 一次性脚手架 / 遗留物（已从 git 移除，本地可保留） ---
# 图标调试产物（icon.png 是正式图标，被 pubspec 引用，必须保留）
icon_check.png
icon_fixed.png
icon_preview.png
icon copy.png
convert_icon.ps1

# C++ 改动的临时 diff 导出
*_diff.txt

# 已废弃的 Python 原型（项目已迁移到 Flutter）
/src/
requirements.txt

# 插件原生库构建产物（由 build_windows.bat / CMake 生成）
plugins/*/windows/*.dll
plugins/*/windows/*.exp
plugins/*/windows/*.lib
