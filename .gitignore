# Flutter
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Build outputs (ephemeral only, not generated CMake files)
windows/flutter/ephemeral/
android/.gradle/
android/app/build/
android/local.properties

# User data
profiles/config.json
macros/*.json

# Misc
*.pyc
__pycache__/
.ruff_cache/
*.pdb

# Driver build caches (recoverable via packages.config / VS)
driver/clicker_filter/.vs/
driver/clicker_filter/packages/
driver/clicker_filter/build/
driver/clicker_filter/x64/
driver/**/*.vcxproj.user

# Allow driver binaries in driver/ directory
!driver/**/*.sys
!driver/**/*.cat
!driver/**/*.inf
